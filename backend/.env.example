GROQ_API_KEY=your_groq_key_here
HF_TOKEN=your_huggingface_token_here

# Optional: set a secret key to protect the /analyze endpoint.
# Laravel must send this in the X-API-Key header.
# Leave empty to disable authentication.
API_KEY=

# Reverse-proxy prefix. Set to "/api" when the app is served at
# qssdemo.shortyhub.com/api behind nginx. Leave empty for local dev.
ROOT_PATH=
